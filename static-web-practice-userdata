#!/bin/bash
yum install -y httpd wget unzip
wget -O titan-folio.zip "https://www.tooplate.com/zip-templates/2147_titan_folio.zip"
unzip titan-folio.zip
sudo cp -r 2147_titan_folio/* /var/www/html/
systemctl enable httpd
systemctl start httpd
systemctl restart httpd
sudo yum install -y https://s3.ap-south-1.amazonaws.com/amazon-ssm-ap-south-1/latest/linux_amd64/amazon-ssm-agent.rpm

