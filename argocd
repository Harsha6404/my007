# Create ArgoCD namespace
kubectl create namespace argocd

# Install ArgoCD
kubectl apply -n argocd -f \
https://raw.githubusercontent.com/argoproj/argo-cd/v2.4.7/manifests/install.yaml

# Expose ArgoCD Server using LoadBalancer
kubectl patch svc argocd-server -n argocd \
-p '{"spec": {"type": "LoadBalancer"}}'

# Wait about 2 minutes for the LoadBalancer to be created

# Install jq
sudo apt install jq -y

# OR check the service manually
kubectl get svc -n argocd

# Export the ArgoCD Server hostname
export ARGOCD_SERVER=$(kubectl get svc argocd-server \
-n argocd \
-o json | jq --raw-output '.status.loadBalancer.ingress[0].hostname')


# Verify the service
kubectl get svc -n argocd

# Check all ArgoCD pods
kubectl get pods -n argocd


#to get passward
kubectl -n argocd get secret argocd-initial-admin-secret \
-o jsonpath="{.data.password}" | base64 -d
